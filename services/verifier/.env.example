# Reclaim (https://dev.reclaimprotocol.org) — yoksa /proof ve /proof/submit 503 döner
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
# YouTube Data API v3 anahtarı (sadece youtube platformu için)
YT_API_KEY=
# Relayer gizli anahtarı (S...). Boşsa scripts/.accounts/secrets.env'den okunur
RELAYER_SECRET=
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Boşsa scripts/.accounts/deploy.env'den okunur
CLIPRAIL_ID=
HUMANITY_ID=
# Demo uç noktasının public HTTPS tabanı (kontrattaki set_platform demo url_prefix ile birebir aynı olmalı)
DEMO_PUBLIC_BASE=https://verifier.example.com
# 1 = /humanity/demo-register açık
DEMO_MODE=1
# 1 = keeper (kanıt gönderimi, finalize_dispute, settle_epoch) arka planda çalışır
KEEPER=0
KEEPER_INTERVAL_MS=5000
# Kabul edilen attestor adresleri (virgülle). Kanıt başka bir attestor'dan gelirse reddedilir ve adres loglanır
RECLAIM_ATTESTORS=0x244897572368eadf65bfbc5aec98d8e5443a9072
# Doluysa /proof/submit, /demo/videos/:id/bump, /humanity/demo-register için "Authorization: Bearer <WRITE_TOKEN>" gerekir
WRITE_TOKEN=
PORT=8787
# "*" (varsayılan) ya da virgülle ayrılmış origin listesi, ör. https://cliprail.example.com,http://localhost:3000
CORS_ORIGIN=*
# Test/replay: bu klasördeki <platform>-<videoId>-<ts>.json kanıtları zkFetch yerine kullanılır
PROOF_FIXTURE_DIR=
# Anon Aadhaar TEST modu: aadhaar-verifier.wasm + circuit_final.zkey (+ vkey.json) klasörü (v2.0.0 artifact'leri).
# Boşsa POST /humanity/aadhaar/prove 503 döner. Göreli yol servis klasörüne göredir.
AADHAAR_ARTIFACTS_DIR=
# UIDAI test QR + anon-aadhaar TEST anahtarı (varsayılan: <repo>/fixtures/aadhaar)
AADHAAR_TEST_DATA_DIR=
