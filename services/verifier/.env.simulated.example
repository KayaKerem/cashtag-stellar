# Simüle attestor modu: Reclaim kimlik bilgisi olmadan tüm web akışı testnet'te çalışır.
# Kanıtları yerel TEST attestor anahtarı imzalar; yalnız bu anahtara güvenen e2e instance kabul eder.
#   cp services/verifier/.env.simulated.example services/verifier/.env.simulated
#   ENV_FILE=.env.simulated pnpm --filter verifier start
# Demo url_prefix'i DEMO_PUBLIC_BASE ile aynı olmalı:
#   pnpm --filter e2e set-demo-host -- https://verifier.example.com
ATTESTOR_MODE=simulated
# Boşsa e2e varsayılanları: keccak256("cliprail-e2e-test-attestor") / keccak256("cliprail-e2e-test-owner")
# (attestor 0x3522ca52bd619e230ef7b5c1845fb19a68a14da9, owner 0xc76daa73f2dcea9d6ac089e008f95b57eba9e6e3)
SIM_ATTESTOR_SECRET=
SIM_OWNER_SECRET=
# e2e instance (scripts/.accounts/e2e.env: E2E_CLIPRAIL_ID / E2E_HUMANITY_ID); deploy.env'deki ana deploy'u ezer
CLIPRAIL_ID=CC4SMPQWP56TUVAUAWMK4BLOONQPBLJAWDVNPE6HMZGEMG67WW4XR7T3
HUMANITY_ID=CB24BRMGW4ZTLJVC2ETKU5URUD7PXQ6BOYEKV4JUIO7O62GZWM6ZZZUM
# Demo uç noktasının public tabanı (e2e instance'taki demo url_prefix = DEMO_PUBLIC_BASE/demo/videos/)
DEMO_PUBLIC_BASE=https://verifier.example.com
DEMO_MODE=1
KEEPER=1
KEEPER_INTERVAL_MS=5000
# Relayer gizli anahtarı (S...). Satır yorumda kalırsa scripts/.accounts/secrets.env'den okunur (boş değer bunu engeller)
# RELAYER_SECRET=
# youtube platformu için (e2e instance'ta yalnız demo tanımlı); boşsa youtube /proof 503 döner
YT_API_KEY=
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Cache/demo verisi ana moddan ayrı dursun
DATA_DIR=.data/simulated
WRITE_TOKEN=
PORT=8787
CORS_ORIGIN=*
# Anon Aadhaar TEST modu: aadhaar-verifier.wasm + circuit_final.zkey (+ vkey.json) klasörü (v2.0.0 artifact'leri).
# Boşsa POST /humanity/aadhaar/prove 503 döner. Göreli yol servis klasörüne göredir.
AADHAAR_ARTIFACTS_DIR=
# UIDAI test QR + anon-aadhaar TEST anahtarı (varsayılan: <repo>/fixtures/aadhaar)
AADHAAR_TEST_DATA_DIR=
