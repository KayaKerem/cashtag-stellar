# Copy to deploy/verifier.env on the server (never commit it). Testnet only.
ATTESTOR_MODE=reclaim
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_DIRECT=1
RECLAIM_ATTESTORS=0x244897572368eadf65bfbc5aec98d8e5443a9072
RELAYER_SECRET=
CLIPRAIL_ID=
HUMANITY_ID=
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Must equal the demo platform url_prefix base on the contract (https://<PUBLIC_HOST>)
DEMO_PUBLIC_BASE=
DEMO_MODE=1
KEEPER_INTERVAL_MS=5000
YT_API_KEY=
# Required: the service refuses to start in production without it (>= 24 chars), e.g. `openssl rand -hex 24`
WRITE_TOKEN=
# Explicit dashboard origin(s), comma-separated; avoid *
CORS_ORIGIN=https://cashtag-stellar-web.vercel.app
# Aadhaar proving jobs running + waiting before 503 (each ~3.7 GB RAM)
AADHAAR_MAX_QUEUE=3
