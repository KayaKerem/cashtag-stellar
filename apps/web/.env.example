# mock | chain — mock: bellek içi örnek veri (@cliprail/client), chain: testnet kontratı
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Kampanya token'ı: Circle testnet USDC (USDC:GBBD47…LFLA5). Anchor ve Soroswap havuzu bu varlıkla çalışır;
# kendi test USDC'miz (CCRCO347…UX45E) yalnız eski seed kampanyalarında.
NEXT_PUBLIC_USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# --- TL ⇄ USDC anchor (SEP-6/10/12/38); "TL yatır" / "TL'ye çek" ekranları ---
# Etkinliğin TR mock anchor'ı; BiLira gibi gerçek bir anchor gelince yalnız bu değişir
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
NEXT_PUBLIC_ANCHOR_ASSET_CODE=USDC

# --- E2E instance + simulated attestor verifier (demo) ---
# Kanıtlar test attestor anahtarıyla imzalanır; header'da "Simulated attestor" rozeti görünür.
# Yalnız `demo` platformu kayıtlı.
NEXT_PUBLIC_CLIPRAIL_ID=CBTEAWEZMV5EBND6EBO5APIN4WYH5MLUILDEEHJ5YYDXR4UW2EDHM7DQ
NEXT_PUBLIC_HUMANITY_ID=CBXO7SKDQ22E7J7QAASIFLSJ7JAPX45YM3QA5KARY5OJHMFP3KTKP5MN
# Tünel adresi yeniden başlatınca değişir; güncel değer Kerem'de (issue #31)
NEXT_PUBLIC_VERIFIER_URL=https://<tunnel>.trycloudflare.com
# Verifier WRITE_TOKEN; tarayıcıya gömülür, yalnızca demo içindir
NEXT_PUBLIC_WRITE_TOKEN=

# Site adresi (OG görseli için); boşsa localhost
NEXT_PUBLIC_SITE_URL=
